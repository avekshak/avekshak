{
  "name": "@avekshak/agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx src/index.ts",
    "seed": "tsx --env-file=../../.env scripts/seed-demo-night.ts",
    "smoke": "tsx --env-file=../../.env scripts/smoke.ts"
  },
  "dependencies": {
    "@avekshak/schema": "workspace:*",
    "@avekshak/queue": "workspace:*",
    "@avekshak/db": "workspace:*",
    "@anthropic-ai/sdk": "^0.32.1",
    "drizzle-orm": "^0.36.4",
    "ioredis": "^5.4.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
