POSTGRES_URL=postgres://avekshak:avekshak@localhost:5433/avekshak
REDIS_URL=redis://localhost:6379
API_PORT=8000

# LLM — Claude (default)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Syslog connector
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514

# Wazuh connector
# When running locally (scripts): use localhost:9200
# When running in Docker: container uses wazuh-indexer:9200 (set via docker-compose env)
WAZUH_ES_URL=https://admin:SecretPassword@localhost:9200
WAZUH_ES_INDEX=wazuh-alerts-*
WAZUH_POLL_MS=10000
